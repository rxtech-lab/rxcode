{
  "id": "app.rxlab.extensions.cloudflare",
  "name": "Cloudflare Usage",
  "version": "1.0.0",
  "pluginAPI": "2.0",
  "readme": "README.md",
  "permissions": [
    {
      "id": "network",
      "domains": [
        "api.cloudflare.com"
      ]
    },
    {
      "id": "credentials.use",
      "slots": [
        "billing",
        "oauth",
        "primary"
      ]
    }
  ],
  "contributes": {
    "usage.provider": [
      {
        "pluginID": "cloudflare",
        "title": "Cloudflare",
        "authentication": "OAuth",
        "fields": {
          "account": "Account ID",
          "resource": "Zone ID, worker:name or r2:name (optional)"
        }
      }
    ],
    "settings": true
  }
}
