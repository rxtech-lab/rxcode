        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Click a plugin to view its details, then press Install. An interactive terminal popup opens and runs the install command automatically."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러그인을 클릭하여 상세 정보를 확인한 후 설치 버튼을 누르세요. 대화형 터미널 팝업이 열리고 설치 커맨드가 자동으로 실행됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
