<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>aps-environment</key>
    <string>development</string>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.app.rxlab.rxcodemobile</string>
    </array>
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:code.rxlab.app</string>
        <string>webcredentials:rxlab.app</string>
        <string>webcredentials:rxlab.app?mode=developer</string>
    </array>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)app.rxlab.rxcodemobile.shared</string>
    </array>
</dict>
</plist>
